{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": [
      "node",
      "@playwright/test"
    ]
  },
  "include": [
    "tests-api/**/*.ts",
    "tests-web/**/*.ts",
    "tests-mobile/**/*.ts",
    "playwright.config.ts"
  ]
}
