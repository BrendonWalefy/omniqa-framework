{
  "name": "omniqa-framework",
  "version": "0.1.0",
  "description": "Framework base para automacao de testes Web, API, Mobile e Performance.",
  "private": true,
  "scripts": {
    "test": "npm run test:regression:skip-mobile",
    "test:playwright": "node core/runners/run-with-report.mjs test:playwright:raw junit",
    "test:playwright:raw": "playwright test",
    "test:api": "node core/runners/run-with-report.mjs test:api:raw junit",
    "test:api:raw": "playwright test --project=api",
    "test:web": "node core/runners/run-with-report.mjs test:web:raw junit",
    "test:web:raw": "playwright test --project=web-chromium",
    "test:web:headed": "node core/runners/run-with-report.mjs test:web:headed:raw junit",
    "test:web:headed:raw": "playwright test --project=web-chromium --headed",
    "report": "playwright show-report reports/playwright-report",
    "report:junit": "tsx core/reports/generate-junit-report.ts",
    "report:performance": "tsx core/reports/generate-performance-report.ts",
    "report:all": "npm run report:junit && npm run report:performance",
    "report:open": "node core/runners/open-reports.mjs reports/junit/report.html reports/performance/report.html",
    "test:mobile:android": "node core/runners/run-with-report.mjs test:mobile:android:raw junit",
    "test:mobile:android:raw": "wdio run wdio.android.conf.ts",
    "test:mobile:ios": "node core/runners/run-with-report.mjs test:mobile:ios:raw junit",
    "test:mobile:ios:raw": "wdio run wdio.ios.conf.ts",
    "prepare:reports": "node core/runners/prepare-reports.mjs",
    "test:performance": "node core/runners/run-with-report.mjs test:performance:raw performance",
    "test:performance:raw": "npm run prepare:reports --silent && k6 run --summary-export=reports/performance/summary.json targets/demo/performance/jsonplaceholder-load.js",
    "appium:doctor:android": "appium driver doctor uiautomator2",
    "appium:doctor:ios": "appium driver doctor xcuitest",
    "test:regression": "node core/runners/regression.mjs",
    "test:regression:skip-mobile": "node core/runners/regression.mjs --skip-mobile",
    "test:regression:skip-ios": "node core/runners/regression.mjs --skip-ios",
    "typecheck": "tsc --noEmit",
    "test:systemops": "npm run test:systemops:smoke",
    "test:systemops:api": "node core/runners/run-with-report.mjs test:systemops:api:raw junit",
    "test:systemops:api:raw": "playwright test --project=systemops-api",
    "test:systemops:web": "node core/runners/run-with-report.mjs test:systemops:web:raw junit",
    "test:systemops:web:raw": "playwright test --project=systemops-web-chromium",
    "test:systemops:mobile-web": "node core/runners/run-with-report.mjs test:systemops:mobile-web:raw junit",
    "test:systemops:mobile-web:raw": "playwright test --project=systemops-web-mobile",
    "test:systemops:smoke": "node core/runners/run-with-report.mjs test:systemops:smoke:raw junit",
    "test:systemops:smoke:raw": "playwright test --project=systemops-api --project=systemops-web-chromium",
    "test:systemops:scheduling": "node core/runners/run-with-report.mjs test:systemops:scheduling:raw junit",
    "test:systemops:scheduling:raw": "playwright test --project=systemops-api targets/systemops/api/specs/scheduling.spec.ts",
    "test:systemops:conversation": "node core/runners/run-with-report.mjs test:systemops:conversation:raw junit",
    "test:systemops:conversation:raw": "playwright test --project=systemops-api targets/systemops/api/specs/conversation-experience.spec.ts",
    "test:systemops:replay": "SYSTEMOPS_RUN_APPROVED_REPLAY=true node core/runners/run-with-report.mjs test:systemops:replay:raw junit",
    "test:systemops:replay:raw": "playwright test --project=systemops-api targets/systemops/api/specs/approved-dataset-replay.spec.ts",
    "test:systemops:menu": "node core/runners/run-with-report.mjs test:systemops:menu:raw junit",
    "test:systemops:menu:raw": "playwright test --project=systemops-api targets/systemops/api/specs/menu.spec.ts",
    "test:systemops:playbook-sandbox": "node core/runners/run-with-report.mjs test:systemops:playbook-sandbox:raw junit",
    "test:systemops:playbook-sandbox:raw": "playwright test --project=systemops-api targets/systemops/api/specs/playbook-sandbox.spec.ts",
    "test:systemops:ui-daily": "node core/runners/run-with-report.mjs test:systemops:ui-daily:raw junit",
    "test:systemops:ui-daily:raw": "playwright test --project=systemops-web-chromium targets/systemops/web/specs/dashboard.spec.ts targets/systemops/web/specs/navigation.spec.ts targets/systemops/web/specs/agenda.spec.ts targets/systemops/web/specs/playbook-editor.spec.ts targets/systemops/web/specs/pwa.spec.ts",
    "test:systemops:daily": "node core/runners/run-with-report.mjs test:systemops:daily:raw junit",
    "test:systemops:daily:raw": "playwright test --project=systemops-api targets/systemops/api/specs/menu.spec.ts targets/systemops/api/specs/playbook-sandbox.spec.ts && playwright test --project=systemops-web-chromium targets/systemops/web/specs/dashboard.spec.ts targets/systemops/web/specs/navigation.spec.ts targets/systemops/web/specs/agenda.spec.ts targets/systemops/web/specs/playbook-editor.spec.ts targets/systemops/web/specs/pwa.spec.ts",
    "test:systemops:performance": "k6 run --summary-export=reports/performance/summary.json targets/systemops/performance/webhook-smoke-load.js",
    "test:systemops:performance:scheduling": "k6 run --summary-export=reports/performance/summary.json targets/systemops/performance/scheduling-smoke-load.js",
    "test:systemops:inbox": "node core/runners/run-with-report.mjs test:systemops:inbox:raw junit",
    "test:systemops:inbox:raw": "playwright test --project=systemops-api targets/systemops/api/specs/inbox.spec.ts",
    "test:systemops:visual": "node core/runners/run-with-report.mjs test:systemops:visual:raw junit",
    "test:systemops:visual:raw": "playwright test --project=systemops-web-chromium targets/systemops/web/specs/visual-regression.spec.ts",
    "test:systemops:visual:update": "playwright test --project=systemops-web-chromium targets/systemops/web/specs/visual-regression.spec.ts --update-snapshots",
    "test:systemops:push": "node core/runners/run-with-report.mjs test:systemops:push:raw junit",
    "test:systemops:push:raw": "playwright test --project=systemops-api targets/systemops/api/specs/push-notifications.spec.ts && playwright test --project=systemops-web-chromium targets/systemops/web/specs/push-notifications.spec.ts",
    "test:systemops:arrival": "node core/runners/run-with-report.mjs test:systemops:arrival:raw junit",
    "test:systemops:arrival:raw": "playwright test --project=systemops-api targets/systemops/api/specs/arrival-experience.spec.ts",
    "test:systemops:noshow": "node core/runners/run-with-report.mjs test:systemops:noshow:raw junit",
    "test:systemops:noshow:raw": "playwright test --project=systemops-api targets/systemops/api/specs/noshow-experience.spec.ts"
  },
  "keywords": [
    "qa",
    "automation",
    "playwright",
    "appium",
    "k6",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": "20.x",
    "npm": ">=10 <11"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@wdio/appium-service": "^9.27.1",
    "@wdio/cli": "^9.27.1",
    "@wdio/globals": "^9.27.1",
    "@wdio/junit-reporter": "^9.27.1",
    "@wdio/local-runner": "^9.27.1",
    "@wdio/mocha-framework": "^9.27.1",
    "@wdio/spec-reporter": "^9.27.1",
    "appium": "^3.4.0",
    "appium-uiautomator2-driver": "^7.2.1",
    "appium-xcuitest-driver": "^11.2.3",
    "tsx": "^4.21.0",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.109.1",
    "openai": "^6.45.0"
  }
}
