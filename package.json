{
  "name": "omniqa-framework",
  "version": "0.1.0",
  "description": "Framework base para automacao de testes Web, API, Mobile e Performance.",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:web": "playwright test --project=web-chromium",
    "test:web:headed": "playwright test --project=web-chromium --headed",
    "report": "playwright show-report reports/playwright-report",
    "test:mobile:android": "wdio run wdio.android.conf.ts",
    "appium:doctor:android": "appium driver doctor uiautomator2",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "qa",
    "automation",
    "playwright",
    "appium",
    "k6",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@wdio/appium-service": "^9.27.1",
    "@wdio/cli": "^9.27.1",
    "@wdio/globals": "^9.27.1",
    "@wdio/local-runner": "^9.27.1",
    "@wdio/mocha-framework": "^9.27.1",
    "@wdio/spec-reporter": "^9.27.1",
    "appium": "^3.4.0",
    "appium-uiautomator2-driver": "^7.2.1",
    "tsx": "^4.21.0",
    "typescript": "^5.8.0"
  }
}
