{
  "name": "omniqa-framework",
  "version": "0.1.0",
  "description": "Framework base para automacao de testes Web, API, Mobile e Performance.",
  "private": true,
  "scripts": {
    "test": "npm run test:regression:skip-mobile",
    "test:playwright": "playwright test",
    "test:api": "playwright test --project=api",
    "test:web": "playwright test --project=web-chromium",
    "test:web:headed": "playwright test --project=web-chromium --headed",
    "report": "playwright show-report reports/playwright-report",
    "report:junit": "tsx scripts/generate-junit-report.ts",
    "report:performance": "tsx scripts/generate-performance-report.ts",
    "report:all": "npm run report:junit && npm run report:performance",
    "report:open": "node scripts/open-reports.mjs reports/junit/report.html reports/performance/report.html",
    "test:mobile:android": "wdio run wdio.android.conf.ts",
    "test:mobile:ios": "wdio run wdio.ios.conf.ts",
    "prepare:reports": "node scripts/prepare-reports.mjs",
    "test:performance": "npm run prepare:reports --silent && k6 run --summary-export=reports/performance/summary.json tests-performance/jsonplaceholder-load.js",
    "appium:doctor:android": "appium driver doctor uiautomator2",
    "appium:doctor:ios": "appium driver doctor xcuitest",
    "test:regression": "node scripts/regression.mjs",
    "test:regression:skip-mobile": "node scripts/regression.mjs --skip-mobile",
    "test:regression:skip-ios": "node scripts/regression.mjs --skip-ios",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "qa",
    "automation",
    "playwright",
    "appium",
    "k6",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@wdio/appium-service": "^9.27.1",
    "@wdio/cli": "^9.27.1",
    "@wdio/globals": "^9.27.1",
    "@wdio/junit-reporter": "^9.27.1",
    "@wdio/local-runner": "^9.27.1",
    "@wdio/mocha-framework": "^9.27.1",
    "@wdio/spec-reporter": "^9.27.1",
    "appium": "^3.4.0",
    "appium-uiautomator2-driver": "^7.2.1",
    "appium-xcuitest-driver": "^11.2.3",
    "tsx": "^4.21.0",
    "typescript": "^5.8.0"
  }
}
